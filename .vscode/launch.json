{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Frontend (Dev Server)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev"
    },
    {
      "name": "Launch Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Run Unit Tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun test"
    }
  ]
}
